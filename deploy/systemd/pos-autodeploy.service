[Unit]
Description=Juniper POS auto-deploy (pull from GitHub, rebuild, health check, rollback)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/final-year-project
ExecStart=/bin/bash /home/ubuntu/final-year-project/deploy/auto-deploy.sh
TimeoutStartSec=30min
